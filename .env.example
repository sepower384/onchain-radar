# ONCHAIN RADAR 키 — 이 파일을 .env 로 복사해서 채운다. .env 는 깃에 올리지 않는다.
# 비어 있는 키는 해당 신호만 꺼지고 봇은 계속 돈다.

# ── 필수 ──────────────────────────────────────────────────────────
# @BotFather → /newbot. 기존 봇과 공유하지 말 것(별도 봇).
TELEGRAM_BOT_TOKEN=
# 명령어를 쓸 수 있는 chat_id (쉼표로 여러 개). 모르면 봇에게 말 건 뒤 `python main.py chats`
TELEGRAM_ALLOWED_CHAT_IDS=

# ── 무료 · 권장 ────────────────────────────────────────────────────
# 없으면 429 가 잦다. https://www.coingecko.com/en/developers/dashboard
COINGECKO_DEMO_KEY=
# EVM 홀더 이력 보조. https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

# ── 무료 · Phase 2 ─────────────────────────────────────────────────
# 솔라나 홀더. https://dashboard.helius.dev
HELIUS_API_KEY=
BIRDEYE_API_KEY=
# 뉴스. https://cryptopanic.com/developers/api/
CRYPTOPANIC_TOKEN=

# ── 유료 · 있을 때만 해당 Stage 활성화 ─────────────────────────────
# Stage 6 뉴스 분류
ANTHROPIC_API_KEY=
# Stage 4 언락 (DefiLlama emissions 는 402 유료라 이게 유일한 경로)
TOKENOMIST_API_KEY=
# 스마트머니 (없으면 상위 비거래소 지갑 순증으로 대체)
NANSEN_API_KEY=
ARKHAM_API_KEY=
